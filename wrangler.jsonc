{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "campusvoice",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "ratelimits": [
    {
      "name": "PUBLIC_APPEAL_RATE_LIMIT",
      "namespace_id": "62021",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "routes": [
    {
      "pattern": "campusvoice.nthusa.tw",
      "zone_name": "nthusa.tw",
      "custom_domain": true
    },
    {
      "pattern": "appeal.nthusa.tw",
      "zone_name": "nthusa.tw",
      "custom_domain": true
    }
  ]
}
